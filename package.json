{
  "name": "@rdlabo/ionic-theme-utils",
  "private": false,
  "version": "0.1.1",
  "description": "Shared utilities for Rdlabo Ionic themes",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "rdlabo-copy-structured-list": "./scripts/copy-structured-list.mjs",
    "rdlabo-check-esm": "./scripts/check-esm.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles": "./src/styles/index.scss",
    "./styles/md-ion-list-inset": "./src/styles/md-ion-list-inset.scss",
    "./styles/*": "./src/styles/*.scss"
  },
  "files": [
    "dist",
    "src",
    "scripts/copy-structured-list.mjs",
    "package.json",
    "README.md",
    "LICENSE",
    "scripts/check-esm.mjs"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "fmt:check": "prettier --check \"./**/*.{js,json,md,mjs,scss,ts,yml}\"",
    "lint": "eslint .",
    "fmt": "prettier --write \"./**/*.{js,json,md,mjs,scss,ts,yml}\"",
    "release": "np --branch main --no-tests --no-publish",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build",
    "test:esm": "node scripts/check-esm.mjs",
    "test:cli": "node --test scripts/check-esm.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/rdlabo-dev/ionic-theme-utils.git"
  },
  "keywords": [
    "ionic",
    "framework",
    "theme",
    "utilities"
  ],
  "author": "Masahiko Sakakibara <sakakibara@rdlabo.jp>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/rdlabo-dev/ionic-theme-utils/issues"
  },
  "homepage": "https://github.com/rdlabo-dev/ionic-theme-utils#readme",
  "peerDependencies": {
    "@ionic/core": ">=8.8.1 <10"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@ionic/core": "^9.0.0",
    "eslint": "^9.39.5",
    "jsdom": "^26.1.0",
    "np": "^10.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  }
}
